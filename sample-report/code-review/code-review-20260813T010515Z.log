    47	    }
    48	
    49	    @ExceptionHandler(DataIntegrityViolationException.class)
    50	    public ResponseEntity<ApiError> handleDataConflict(DataIntegrityViolationException exception,
    51	                                                       HttpServletRequest request) {
    52	        return error(HttpStatus.CONFLICT, "The request conflicts with persisted data",
    53	                request.getRequestURI(), Map.of());
    54	    }
    55	
    56	    @ExceptionHandler(ObjectOptimisticLockingFailureException.class)
    57	    public ResponseEntity<ApiError> handleConcurrentUpdate(ObjectOptimisticLockingFailureException exception,
    58	                                                           HttpServletRequest request) {
    59	        return error(HttpStatus.CONFLICT, "The order was changed by another request; reload and retry",
    60	                request.getRequestURI(), Map.of());
    61	    }
    62	
    63	    @ExceptionHandler(StaleOrderVersionException.class)
    64	    public ResponseEntity<ApiError> handleStaleVersion(StaleOrderVersionException exception,
    65	                                                       HttpServletRequest request) {
    66	        return error(HttpStatus.PRECONDITION_FAILED, exception.getMessage(),
    67	                request.getRequestURI(), Map.of());
    68	    }
    69	
    70	    @ExceptionHandler(Exception.class)
    71	    public ResponseEntity<ApiError> handleUnexpected(Exception exception, HttpServletRequest request) {
    72	        LOGGER.error("Unexpected request failure for path {}", request.getRequestURI(), exception);
    73	        return error(HttpStatus.INTERNAL_SERVER_ERROR, "An unexpected error occurred",
    74	                request.getRequestURI(), Map.of());
    75	    }
    76	
    77	    private ResponseEntity<ApiError> error(HttpStatus status, String message, String path,
    78	                                           Map<String, String> validationErrors) {
    79	        var body = new ApiError(Instant.now(), status.value(), status.getReasonPhrase(), message,
    80	                path, validationErrors);
    81	        return ResponseEntity.status(status).body(body);
    82	    }
    83	}
