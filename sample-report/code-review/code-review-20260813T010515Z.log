    13	
    14	@Configuration
    15	public class SecurityConfig {
    16	
    17	    @Bean
    18	    @Profile("local")
    19	    SecurityFilterChain localSecurityFilterChain(HttpSecurity http) throws Exception {
    20	        http
    21	                .csrf(csrf -> csrf.ignoringRequestMatchers("/api/**", "/h2-console/**"))
    22	                .headers(headers -> headers.frameOptions(frameOptions -> frameOptions.sameOrigin()))
    23	                .authorizeHttpRequests(authorize -> authorize
    24	                        .requestMatchers(HttpMethod.GET, "/api/orders/**").permitAll()
    25	                        .requestMatchers("/actuator/health/**", "/h2-console/**").permitAll()
    26	                        .requestMatchers("/actuator/**").hasRole("OPERATIONS")
    27	                        .requestMatchers("/api/orders/**").hasRole("ORDER_ADMIN")
    28	                        .anyRequest().authenticated())
    29	                .httpBasic(Customizer.withDefaults());
    30	        return http.build();
    31	    }
    32	
    33	    @Bean
    34	    @Profile("prod")
    35	    SecurityFilterChain productionSecurityFilterChain(HttpSecurity http) throws Exception {
    36	        http
    37	                .csrf(csrf -> csrf.disable())
    38	                .sessionManagement(session -> session.sessionCreationPolicy(SessionCreationPolicy.STATELESS))
    39	                .authorizeHttpRequests(authorize -> authorize
    40	                        .requestMatchers(HttpMethod.GET, "/api/orders/**")
    41	                        .hasAnyRole("ORDER_READER", "ORDER_ADMIN")
    42	                        .requestMatchers("/actuator/health/**").permitAll()
    43	                        .requestMatchers("/actuator/**").hasRole("OPERATIONS")
    44	                        .requestMatchers("/api/orders/**").hasRole("ORDER_ADMIN")
    45	                        .anyRequest().authenticated())
    46	                .oauth2ResourceServer(oauth2 -> oauth2.jwt(jwt ->
    47	                        jwt.jwtAuthenticationConverter(jwtAuthenticationConverter())));
    48	        return http.build();
    49	    }
    50	
    51	    private JwtAuthenticationConverter jwtAuthenticationConverter() {
    52	        var authorities = new JwtGrantedAuthoritiesConverter();
    53	        authorities.setAuthoritiesClaimName("roles");
    54	        authorities.setAuthorityPrefix("ROLE_");
    55	
    56	        var converter = new JwtAuthenticationConverter();
    57	        converter.setJwtGrantedAuthoritiesConverter(authorities);
    58	        return converter;
    59	    }
    60	}
