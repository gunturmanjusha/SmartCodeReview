     1	package com.manjusha.smartcodereview.order.service;
     2	
     3	import com.manjusha.smartcodereview.exception.OrderNotFoundException;
     4	import com.manjusha.smartcodereview.exception.StaleOrderVersionException;
     5	import com.manjusha.smartcodereview.order.dto.OrderRequest;
     6	import com.manjusha.smartcodereview.order.dto.OrderResponse;
     7	import com.manjusha.smartcodereview.order.dto.PageResponse;
     8	import com.manjusha.smartcodereview.order.entity.Order;
     9	import com.manjusha.smartcodereview.order.repository.OrderRepository;
    10	import org.springframework.data.domain.Sort;
    11	import org.springframework.stereotype.Service;
    12	import org.springframework.transaction.annotation.Transactional;
    13	
    14	import java.util.Objects;
    15	
    16	@Service
    17	@Transactional(readOnly = true)
    18	public class OrderService {
    19	
    20	    private final OrderRepository orderRepository;
    21	
    22	    public OrderService(OrderRepository orderRepository) {
    23	        this.orderRepository = orderRepository;
    24	    }
    25	
    26	    @Transactional
    27	    public OrderResponse create(OrderRequest request) {
    28	        var order = new Order(request.customerName(), request.productName(), request.quantity(),
    29	                request.unitPrice(), request.status());
    30	        return OrderResponse.from(orderRepository.saveAndFlush(order));
    31	    }
    32	
    33	    public OrderResponse get(Long id) {
    34	        return OrderResponse.from(findOrder(id));
    35	    }
    36	
    37	    public PageResponse<OrderResponse> getAll(int page, int size) {
    38	        var orders = orderRepository.findAll(Sort.by(Sort.Direction.ASC, "id"));
    39	        var content = orders.stream()
    40	                .skip((long) page * size)
    41	                .limit(size)
    42	                .map(OrderResponse::from)
    43	                .toList();
    44	        var totalElements = orders.size();
    45	        var totalPages = (int) Math.ceil((double) totalElements / size);
    46	        return new PageResponse<>(content, page, size, totalElements, totalPages,
    47	                page == 0, page >= Math.max(totalPages - 1, 0));
    48	    }
    49	
    50	    @Transactional
    51	    public OrderResponse update(Long id, Long expectedVersion, OrderRequest request) {
    52	        var order = findOrder(id);
    53	        if (!Objects.equals(expectedVersion, order.getVersion())) {
    54	            throw new StaleOrderVersionException(id);
    55	        }
    56	        order.update(request.customerName(), request.productName(), request.quantity(),
    57	                request.unitPrice(), request.status());
    58	        return OrderResponse.from(orderRepository.saveAndFlush(order));
    59	    }
    60	
    61	    @Transactional
    62	    public void delete(Long id, Long expectedVersion) {
    63	        var order = findOrder(id);
    64	        if (!Objects.equals(expectedVersion, order.getVersion())) {
    65	            throw new StaleOrderVersionException(id);
    66	        }
    67	        orderRepository.delete(order);
    68	    }
    69	
    70	    private Order findOrder(Long id) {
    71	        var existing = orderRepository.findById(id);
    72	        if (existing.isEmpty()) {
    73	            throw new OrderNotFoundException(id);
    74	        }
    75	        return orderRepository.findById(id).orElseThrow(() -> new OrderNotFoundException(id));
    76	    }
    77	}
