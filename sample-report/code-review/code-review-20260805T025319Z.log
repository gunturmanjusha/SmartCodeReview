     1	package com.manjusha.smartcodereview.exception;
     2	
     3	import jakarta.servlet.http.HttpServletRequest;
     4	import jakarta.validation.ConstraintViolationException;
     5	import org.slf4j.Logger;
     6	import org.slf4j.LoggerFactory;
     7	import org.springframework.dao.DataIntegrityViolationException;
     8	import org.springframework.orm.ObjectOptimisticLockingFailureException;
     9	import org.springframework.http.HttpStatus;
    10	import org.springframework.http.ResponseEntity;
    11	import org.springframework.http.converter.HttpMessageNotReadableException;
    12	import org.springframework.web.bind.MethodArgumentNotValidException;
    13	import org.springframework.web.bind.annotation.ExceptionHandler;
    14	import org.springframework.web.bind.annotation.RestControllerAdvice;
    15	import org.springframework.web.method.annotation.HandlerMethodValidationException;
    16	
    17	import java.time.Instant;
    18	import java.util.LinkedHashMap;
    19	import java.util.Map;
    20	
    21	@RestControllerAdvice
    22	public class GlobalExceptionHandler {
    23	
    24	    private static final Logger LOGGER = LoggerFactory.getLogger(GlobalExceptionHandler.class);
    25	
    26	    @ExceptionHandler(OrderNotFoundException.class)
    27	    public ResponseEntity<ApiError> handleNotFound(OrderNotFoundException exception,
    28	                                                    HttpServletRequest request) {
    29	        return error(HttpStatus.NOT_FOUND, exception.getMessage(), request.getRequestURI(), Map.of());
    30	    }
    31	
    32	    @ExceptionHandler(MethodArgumentNotValidException.class)
    33	    public ResponseEntity<ApiError> handleValidation(MethodArgumentNotValidException exception,
    34	                                                      HttpServletRequest request) {
    35	        Map<String, String> fields = new LinkedHashMap<>();
    36	        exception.getBindingResult().getFieldErrors()
    37	                .forEach(error -> fields.putIfAbsent(error.getField(), error.getDefaultMessage()));
    38	        return error(HttpStatus.BAD_REQUEST, "Request validation failed", request.getRequestURI(), fields);
    39	    }
    40	
    41	    @ExceptionHandler({HttpMessageNotReadableException.class, HandlerMethodValidationException.class,
    42	            ConstraintViolationException.class})
    43	    public ResponseEntity<ApiError> handleMalformedRequest(Exception exception,
    44	                                                           HttpServletRequest request) {
    45	        return error(HttpStatus.BAD_REQUEST, "Request is malformed or contains an invalid value",
    46	                request.getRequestURI(), Map.of());
    47	    }
    48	
    49	    @ExceptionHandler(DataIntegrityViolationException.class)
    50	    public ResponseEntity<ApiError> handleDataConflict(DataIntegrityViolationException exception,
    51	                                                       HttpServletRequest request) {
    52	        return error(HttpStatus.CONFLICT, "The request conflicts with persisted data",
    53	                request.getRequestURI(), Map.of());
    54	    }
    55	
    56	    @ExceptionHandler(ObjectOptimisticLockingFailureException.class)
    57	    public ResponseEntity<ApiError> handleConcurrentUpdate(ObjectOptimisticLockingFailureException exception,
    58	                                                           HttpServletRequest request) {
    59	        return error(HttpStatus.CONFLICT, "The order was changed by another request; reload and retry",
    60	                request.getRequestURI(), Map.of());
    61	    }
    62	
    63	    @ExceptionHandler(StaleOrderVersionException.class)
    64	    public ResponseEntity<ApiError> handleStaleVersion(StaleOrderVersionException exception,
    65	                                                       HttpServletRequest request) {
    66	        return error(HttpStatus.PRECONDITION_FAILED, exception.getMessage(),
    67	                request.getRequestURI(), Map.of());
    68	    }
    69	
    70	    @ExceptionHandler(Exception.class)
    71	    public ResponseEntity<ApiError> handleUnexpected(Exception exception, HttpServletRequest request) {
    72	        LOGGER.error("Unexpected request failure for path {}", request.getRequestURI(), exception);
    73	        return error(HttpStatus.INTERNAL_SERVER_ERROR, "An unexpected error occurred",
    74	                request.getRequestURI(), Map.of());
    75	    }
    76	
    77	    private ResponseEntity<ApiError> error(HttpStatus status, String message, String path,
    78	                                           Map<String, String> validationErrors) {
    79	        var body = new ApiError(Instant.now(), status.value(), status.getReasonPhrase(), message,
    80	                path, validationErrors);
    81	        return ResponseEntity.status(status).body(body);
    82	    }
    83	}

